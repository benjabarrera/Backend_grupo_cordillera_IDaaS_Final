{
  "realm": "cordillera-lab",
  "enabled": true,
  "displayName": "Grupo Cordillera - Laboratorio EP5",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "roles": {
    "realm": [
      {
        "name": "SUPER_ADMIN",
        "description": "Administracion EP5"
      },
      {
        "name": "ADMIN_VENTAS"
      },
      {
        "name": "ADMIN_INVENTARIO"
      },
      {
        "name": "ANALISTA"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cordillera-postman",
      "name": "Cliente de pruebas Postman EP5",
      "description": "Cliente publico local de pruebas con Authorization Code PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://oauth.pstmn.io/v1/browser-callback",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-cordillera-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "cordillera-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "scope-en-scp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "scp",
            "claim.value": "access_as_user",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles-de-usuario",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "usermodel.realmRoleMapping.rolePrefix": ""
          }
        }
      ]
    }
  ]
}
