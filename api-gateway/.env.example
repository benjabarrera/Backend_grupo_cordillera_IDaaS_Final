# COPIAR COMO api-gateway/.env (archivo PRIVADO, nunca subir a GitHub).
# Generar claves propias y usar valores que correspondan a TU entorno.
# La clave de EP5_ADMIN_TOKEN necesita un minimo de 20 caracteres.
LOCAL_POSTGRES_PASSWORD=CAMBIAR_CLAVE_POSTGRES_LOCAL
METABASE_DB_PASSWORD=CAMBIAR_CLAVE_METABASE_LOCAL
SONAR_DB_PASSWORD=CAMBIAR_CLAVE_SONAR_LOCAL
RABBITMQ_DEFAULT_USER=cordillera
RABBITMQ_DEFAULT_PASS=CAMBIAR_CLAVE_RABBITMQ
RABBITMQ_ERLANG_COOKIE=CAMBIAR_COOKIE_ALEATORIA_DEL_CLUSTER
EP5_ADMIN_TOKEN=CAMBIAR_CLAVE_ADMIN_LARGA_Y_ALEATORIA
# Solo si se ejecutan los microservicios con docker-compose.azure-db.yml:
AZURE_PG_HOST=HOST_AZURE_POSTGRES
AZURE_PG_USER=USUARIO_AZURE_POSTGRES
AZURE_PG_PASSWORD=CONTRASENA_AZURE_POSTGRES

# Solo en caso de ejecutar compatibilidad JWT legacy; Entra ID no necesita esta clave
JWT_SECRET=
