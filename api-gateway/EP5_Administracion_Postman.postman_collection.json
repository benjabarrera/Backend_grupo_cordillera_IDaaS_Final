            }
          ]
        },
        "url": "{{gatewayUrl}}/admin/kafka/groups/cordillera-alertas-ventas/offsets"
      }
    },
    {
      "name": "07 Kafka eliminar topic temporal",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-EP5-Admin-Key",
            "value": "{{adminKey}}"
