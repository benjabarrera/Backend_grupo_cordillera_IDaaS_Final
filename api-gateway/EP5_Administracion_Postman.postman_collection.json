        "url": "{{gatewayUrl}}/admin/rabbit/bindings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"exchange\": \"ep5.demo\",\n  \"queue\": \"ep5.demo\",\n  \"routingKey\": \"ep5.audit\"\n}",
          "options": {
            "raw": {
              "language": "json"
