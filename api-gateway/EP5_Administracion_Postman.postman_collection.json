{
  "info": {
    "name": "EP5 Grupo Cordillera - Administracion autenticada",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Flujos EP5. Usar token Entra SUPER_ADMIN legitimo y X-EP5-Admin-Key; ejecutar DELETE solo al final."
  },
  "item": [
    {
      "name": "01 Kafka listar topics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-EP5-Admin-Key",
            "value": "{{adminKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{gatewayUrl}}/admin/kafka/topics"
      }
    },
    {
      "name": "02 Kafka crear ep5-validacion-final",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-EP5-Admin-Key",
            "value": "{{adminKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{gatewayUrl}}/admin/kafka/topics",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"ep5-validacion-final\",\n  \"particiones\": 3,\n  \"replicacion\": 2,\n  \"retentionMs\": 3600000,\n  \"cleanupPolicy\": \"delete\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 Kafka modificar retencion",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-EP5-Admin-Key",
            "value": "{{adminKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{gatewayUrl}}/admin/kafka/topics/ep5-validacion-final/config",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"retention.ms\": \"7200000\",\n  \"cleanup.policy\": \"delete\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 Kafka consultar topic",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-EP5-Admin-Key",
